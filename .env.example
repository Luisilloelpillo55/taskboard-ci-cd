# Copy this file to .env before running the local Docker Compose setup.
TASKBOARD_APP_ENV_FILE=.env
TASKBOARD_DATA_DIR=taskboard-data
TASKBOARD_UID=10001
TASKBOARD_GID=10001
TASKBOARD_BIND_ADDRESS=127.0.0.1
TASKBOARD_IMAGE=ghcr.io/luisilloelpillo55/taskboard-ci-cd:latest
COOKIE_SECURE=false
OTEL_SERVICE_NAME=taskboard
# Optional. Keep credentials out of this file and the repository.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
